<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Official NuGet (for CI/CD and machines with internet access) -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- NOTE: If nuget.org is unreachable, add your organisation's NuGet proxy here.
       Credentials should be stored in the user-level NuGet.Config, never committed to source control. -->
</configuration>
